    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts your reps and checks your form during a set, and takes meal photos when you choose to. Video stays on this iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练时用来计数和检查动作，也用于你选择拍摄的餐食照片。视频只在这部 iPhone 上处理。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads your sleep, heart rate variability, resting heart rate and breathing rate to suggest today's training. Raw Health data never leaves this iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你的睡眠、心率变异性、静息心率和呼吸频率，用来建议今天的训练。原始健康数据不会离开这部 iPhone。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves your workouts, meals and weight to Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的训练、饮食和体重保存到“健康”。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
