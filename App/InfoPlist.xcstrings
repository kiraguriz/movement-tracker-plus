            "state" : "translated",
            "value" : "Movement Tracker+"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movement Tracker+"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts your reps and checks your form during a set, and takes meal photos when you choose to. Video stays on this iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练时用来计数和检查动作，也用于你选择拍摄的餐食照片。视频只在这部 iPhone 上处理。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads your sex, date of birth, height and weight to fill in your profile, and your sleep, heart rate variability, resting heart rate and breathing rate to suggest today's training. Raw sleep and heart readings never leave this iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你的性别、出生日期、身高和体重来填写个人资料，并读取睡眠、心率变异性、静息心率和呼吸频率来建议今天的训练。原始睡眠和心率读数不会离开这部 iPhone。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves your workouts, meals and weight to Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的训练、饮食和体重保存到“健康”。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
