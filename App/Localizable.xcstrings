    "teach.fail.noMotion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I didn’t see you move. Step back so your whole body is in view, then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有看到你的动作。后退一些让全身入镜，然后再试一次。"
          }
        }
      }
    },
    "teach.fail.tooFew %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "I could only make out %lld clean rep. Do 3 slow, full reps."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "I could only make out %lld clean reps. Do 3 slow, full reps."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "只看清了 %lld 次完整动作。请慢速做 3 次完整动作。"
                }
              }
            }
          }
        }
      }
    },
    "teach.fail.mismatch %lld %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I counted %1$lld, not %2$lld. Move the same way on every rep and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我数到 %1$lld 次，而不是 %2$lld 次。每次动作保持一致，再试一次。"
          }
        }
      }
    },
    "teach.fail.partial" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some reps were shallower than the others. Go through the full range every time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有些动作幅度比其他的小。每次都做满全程。"
